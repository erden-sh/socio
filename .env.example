# Socio. The UI opens in setup state until the required fields are set.
HOST=127.0.0.1
PORT=4310
# The pages' build (pnpm run build); pnpm start loads it at startup.
# WEB_BUILD_DIR=dist/web
DATABASE_PATH=data/company-brain.sqlite
# Backups (CB-63): the database, the data spaces and, with S3, a mirror of
# the objects, taken by the app every BACKUP_INTERVAL_HOURS (0: off) and by
# pnpm run backup. BACKUP_KEEP of each are kept. Restoring needs the data key.
# BACKUP_DIR=data/backups
# BACKUP_KEEP=14
# BACKUP_INTERVAL_HOURS=24
# Permanent removals' backups (BACKUP_DIR/purge-<time>/, CB-391) go with the
# first scheduled backup after this many days (1 to 365); Settings can change it.
# PURGE_BACKUP_DAYS=30
# An off-site copy to any S3-compatible store, off unless BACKUP_S3_ENDPOINT
# is set. The database and datasets are sealed with DATA_ENCRYPTION_KEY
# first, which it needs; files and objects already are.
# BACKUP_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_FORCE_PATH_STYLE=true
# BACKUP_S3_PREFIX=company-brain/
# JSON {"accessKeyId","secretAccessKey"}. Prefer BACKUP_S3_CREDENTIALS_FILE.
# BACKUP_S3_CREDENTIALS=
# BACKUP_S3_CREDENTIALS_FILE=
# Litestream's file replica of the database (CB-109). With the off-site copy
# too, the app seals its new files and sends them there every
# BACKUP_LTX_INTERVAL_SECONDS (0: off; 10 to 86400). Admins can change both
# intervals in Settings -> General -> Backup schedule.
# LITESTREAM_REPLICA_DIR=
# BACKUP_LTX_INTERVAL_SECONDS=60
# The users' data spaces (datasets and encrypted files); next to the database
# by default. pnpm run backup copies it too.
# USER_DATA_DIR=data/userdata
# The app as Dots' computers reach it, for their scoped data token (the compose
# overlay: http://app:4310). Unset: computers get no data token.
# DATA_API_URL=
# Data space limits (defaults shown); they apply to every Dot.
# DATA_DATASET_MAX_MB=100
# DATA_USER_MAX_MB=1024
# DATA_FILE_MAX_MB=25
# DATA_MAX_DATASETS=50
# Company socio shared files/datasets: 0 retains them until deleted.
# DATA_SHARED_RETENTION_DAYS=0
# Days deleted rows' stamps are kept for offline sync (changes?since=, CB-451).
# DATA_STAMP_TOMBSTONE_DAYS=30
# DATA_QUERY_TIMEOUT_MS=5000
# DATA_QUERY_MAX_ROWS=500
# DATA_QUERY_MAX_BYTES=262144
# DATA_STATEMENTS_PER_MINUTE=120
# DATA_TOKEN_TTL_MINUTES=60
# A service plugin's own datasets (plugin:<id>): their size, rows per query
# and each plugin token's data operations a minute (an admin may change all
# three in Settings, the last per plugin too), and how long one batch runs.
# DATA_PLUGIN_DATASET_MAX_MB=100
# DATA_PLUGIN_QUERY_MAX_ROWS=500
# DATA_PLUGIN_STATEMENTS_PER_MINUTE=600
# DATA_BATCH_TIMEOUT_MS=30000
# Analytical tables' retention when neither an admin's override nor the
# plugin sets one (CB-387); 0 keeps everything. Admins change it in Settings.
# DATA_ANALYTICS_RETAIN_DAYS=0
# Chat attachments (CB-54): images larger than this are kept but not shown to
# the model (it gets a note instead).
# MEDIA_IMAGE_MODEL_MAX_MB=10
# The data space's files in an S3-compatible object store (CB-54; the stack
# bundles SeaweedFS, but any S3-compatible store works): set S3_ENDPOINT and
# the key pair. Unset: files stay on the local disk under USER_DATA_DIR. Once
# S3 is set, local files move there in the background, once. Files are
# stored encrypted either way.
# STORAGE_DRIVER=        # local or s3; s3 when S3_ENDPOINT is set
# S3_ENDPOINT=http://127.0.0.1:8333
# S3_BUCKET=company-brain
# S3_REGION=us-east-1
# true: <endpoint>/<bucket>/<key>; false: virtual-hosted, <bucket>.<host>/<key>.
# S3_FORCE_PATH_STYLE=true
# JSON {"accessKeyId","secretAccessKey"}. SeaweedFS's identity file works too
# (the identity named S3_IDENTITY). Prefer S3_CREDENTIALS_FILE.
# S3_CREDENTIALS=
# S3_CREDENTIALS_FILE=
# S3_IDENTITY=company-brain
# The object keys' first level: the one workspace today.
# TENANT_ID=main
# Mini apps: served on <APPS_LABEL_PREFIX><app>--<dot>.<APPS_HOST>;
# apps.<APP_ORIGIN host> by default (apps.localhost locally), off to turn them
# off; it may be APP_ORIGIN's own host. Live use needs a wildcard DNS entry and
# proxy host for *.<APPS_HOST> (docs/SETUP.md).
# APPS_HOST=
# e.g. app-: only labels starting with it under APPS_HOST are apps.
# APPS_LABEL_PREFIX=
# Promoted mini apps: the workspace app runtime (pnpm run apps-runtime)
# and its shared token (24+ characters; the runtime needs the same value).
# APPS_RUNTIME_URL=http://127.0.0.1:4330
# APPS_RUNTIME_TOKEN=
# APPS_SESSION_HOURS=12
# APPS_MAX_REQUEST_MB=10
# APPS_MAX_RESPONSE_MB=100
# APPS_TIMEOUT_SECONDS=30
# APPS_IDLE_SECONDS=300
# Workspace plugins (docs/PLUGINS.md). Empty or off: nothing is offered,
# the bundled calendar included (CB-371). bundled:calendar offers the
# calendar, bundled:social-strategy the planner, on this instance only.
# file:/path/catalog.json offers manifests from a file. An installed plugin
# that is no longer listed stays installed. -bundled:<id> is accepted and
# takes nothing away. Comma-separated.
# PLUGIN_CATALOGS=
# Where that catalog may be used: the public hosts that may offer it
# (unset: this instance's own host) and hosts that never may. Boot refuses
# a catalog outside the first list or inside the second.
# PLUGIN_CATALOG_HOSTS=
# PLUGIN_CATALOG_DENY_HOSTS=
# Shared by Socio and a plugin service that calls back (24+ characters).
# The planner's manifest names the swarm secret company_brain_plugin_service_token.
# PLUGIN_SERVICE_TOKEN=
# Plugin services on the apps runtime. Off unless APPS_RUNTIME_DOCKER=on,
# and only on a deployment that gives the apps runtime a Docker socket proxy
# (the socket is not on the default stack). The image allow list is required when Docker is on.
# APPS_RUNTIME_DOCKER=
# APPS_RUNTIME_IMAGE_ALLOW=company-brain-plugin-
# Services joined to each plugin's network (comma-separated), the same
# names as the socket proxy's SOCKET_PROXY_INFRA_SERVICES.
# APPS_RUNTIME_INFRA_SERVICES=
# APPS_RUNTIME_DOCKER_HOST=/var/run/docker.sock
# APPS_RUNTIME_PULL=
# APPS_RUNTIME_BUILD_ROOT=
# APPS_RUNTIME_SERVICE_MAX_REPLICAS=5
# APPS_RUNTIME_IMAGE_TAG=
# Operations analytics (CB-186, docs/OPERATIONS-ANALYTICS.md): a DuckDB file
# of derived data in analytics/ next to the database, owned by its own
# process. child (the default): forked by the app; service: the stack's
# socio-analytics at OPS_ANALYTICS_URL with a shared secret (24+ characters,
# the same on both); off: none.
# OPS_ANALYTICS_MODE=child
# OPS_ANALYTICS_URL=http://socio-analytics:4340
# OPS_ANALYTICS_SECRET_FILE=
# OPS_ANALYTICS_DIR=
# DuckDB's memory and threads, and how often it reads the database; admins
# can change them in Operations → Settings.
# OPS_ANALYTICS_MEMORY_MB=512
# OPS_ANALYTICS_THREADS=2
# OPS_ETL_EVERY_SECONDS=60
# How long the analytics store keeps turn facts and their rollups, in days
# (0: as long as the database keeps the turns), and hourly rollups (30).
# OPS_FACT_DAYS=0
# OPS_HOURLY_DAYS=0
# Resource collection/retention (admin Settings overrides these defaults; days 0 keeps history):
# OPS_SAMPLE_EVERY_SECONDS=300
# OPS_SAMPLE_DAYS=400
# OPS_PAGE_USE_DAYS=400
# OPS_PAGE_SEARCH_DAYS=0
# OPS_NOTIFICATION_DAYS=0
# OPS_NOTIFICATION_DELIVERY_DAYS=400
# OPS_NOTICE_DAYS=0
# Domains (Platform page, operators): hostnames through Nginx Proxy Manager
# and Cloudflare DNS (docs/SETUP.md "Domains"). Off unless all of these are
# set; `none` counts as unset. Locally, point the URLs at stand-ins only.
# DOMAINS_ZONE=example.com
# DOMAINS_BASE=brain.example.com
# DOMAINS_TARGET_IP=10.0.0.10
# DOMAINS_UPSTREAM=http://company-brain_app:4310
# NPM_API_URL=http://ingress_proxy:81/api
# The scoped NPM user's login, JSON {"email": "…", "password": "…"} (or NPM_CREDENTIALS).
# NPM_CREDENTIALS_FILE=
# A Cloudflare token with Zone → DNS → Edit on DOMAINS_ZONE only (or CLOUDFLARE_DNS_TOKEN).
# CLOUDFLARE_DNS_TOKEN_FILE=
# Skips the zone lookup; api.cloudflare.com/client/v4 unless CLOUDFLARE_API_URL is set.
# CLOUDFLARE_ZONE_ID=
# The Let's Encrypt account address: the NPM user's email. Unset: no certificates.
# DOMAINS_ACME_EMAIL=
# NPM_TIMEOUT_SECONDS=15
# NPM_CERTIFICATE_TIMEOUT_SECONDS=300
# CLOUDFLARE_TIMEOUT_SECONDS=15
# Schedules and jobs (defaults shown); they apply to every Dot.
# SCHEDULE_MIN_INTERVAL_MINUTES=15
# SCHEDULES_PER_USER=20
# JOB_MAX_TIMEOUT_SECONDS=900
# JOB_CONCURRENCY=2
# JOB_WAKE_SECONDS=90
# JOBS_PER_USER=50
# Accounts: mock (the default) or betterauth (real sign-in; see the block
# below and docs/SETUP.md "Sign-in"). With mock auth anyone who reaches the
# app can pick any user, so it runs only on a loopback HOST and APP_ORIGIN;
# anything other machines reach uses betterauth.
AUTH_PROVIDER=mock
# JSON array of {"id","name","role"}; role operator, admin or member; unique
# lowercase ids, at least one admin or operator. Defaults to alice (operator)
# and bob (member). Keep ids stable.
# MOCK_USERS=[{"id":"alice","name":"Alice","role":"operator"},{"id":"bob","name":"Bob","role":"member"}]
# Signs session cookies (24+ characters). Required off loopback; on loopback an
# empty value uses a per-process secret and signs everyone out on restart.
SESSION_SECRET=
# Seals files and stored credentials at rest (CB-62): 32 random bytes as hex
# or base64 (openssl rand -hex 32). Unset: a key from SESSION_SECRET, as
# before (production warns). Backups need this key to be restored; keep a
# copy apart from them. Rotating: the new one here, the old one as
# DATA_ENCRYPTION_KEY_PREVIOUS until /healthz says "dataKey": "ok".
# DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_PREVIOUS=
# Legacy single-owner ID: its data moves to the first admin on startup.
OWNER_ID=company-brain-owner
# pnpm run dev allows http://localhost:4310 and http://127.0.0.1:4310.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:4310,http://127.0.0.1:4310

# Sign-in with Better Auth (AUTH_PROVIDER=betterauth). Needs SESSION_SECRET
# and exactly one APP_ORIGIN (passkeys, cookies and redirects are bound to
# it). Create the first admin with: pnpm run auth create-user --email …
# The first admin, who is also the workspace owner, made at boot while the
# workspace has no active admin: its email, and the existing app user id to
# link. Formerly AUTH_OPERATOR_EMAIL and AUTH_OPERATOR_LINK (read for two
# more releases, with a warning).
# AUTH_FIRST_ADMIN_EMAIL=admin@example.com
# AUTH_FIRST_ADMIN_LINK=alice
# Methods (both on by default):
# AUTH_PASSWORD=true
# AUTH_PASSKEY=true
# Invite-only unless this is true (anyone may then create an account):
# AUTH_OPEN_SIGNUP=false
# Verified emails that are always admins (and may join by OAuth):
# AUTH_ADMIN_EMAILS=
# Who else may join by OAuth (verified emails / domains):
# AUTH_ALLOWED_EMAILS=
# AUTH_ALLOWED_DOMAINS=
# Existing user id -> email, so earlier data stays with its owner:
# AUTH_LINK_USERS={"alice":"alice@example.com"}
# Behind a reverse proxy: rate limits use the last X-Forwarded-For hop.
# AUTH_TRUST_PROXY=false
# The link domain the Socio app's sign-in links use (a test bench's tunnel),
# for the production and preview builds:
# AUTH_APP_LINK_HOST=link.socio.sh
# The development build's link domain (never the production one, which
# doesn't serve development links):
# AUTH_APP_LINK_HOST_DEV=link-staging.socio.sh
# Add a device links for the development build too (local testing only; the
# server refuses to start with it under NODE_ENV=production):
# AUTH_APP_DEV_LINKS=false
# Invites and "Send me a link for the app" open the Socio app, through the
# link domain (an admin's switch in Settings → General wins):
# AUTH_APP_INVITE_LINKS=false
# The app's links are for the preview build (team testers), not production:
# AUTH_APP_PREVIEW_LINKS=false
# Generic OAuth/OIDC providers (comma-separated ids), each with its own
# AUTH_OAUTH_<ID>_* settings; the callback is APP_ORIGIN/api/auth/callback/<id>.
# AUTH_OAUTH_PROVIDERS=logto
# AUTH_OAUTH_LOGTO_ISSUER=https://auth.example.com/oidc
# AUTH_OAUTH_LOGTO_CLIENT_ID=
# AUTH_OAUTH_LOGTO_CLIENT_SECRET_FILE=/run/secrets/company_brain_logto_client_secret
# AUTH_OAUTH_LOGTO_NAME=Logto
# AUTH_OAUTH_LOGTO_SCOPES=openid profile email roles
# AUTH_OAUTH_LOGTO_GROUPS_CLAIM=roles
# AUTH_OAUTH_LOGTO_ADMIN_GROUP=brain-admin
# AUTH_OAUTH_LOGTO_ALLOWED_GROUPS=
# Optional SMTP for password resets, invites and email verification. Without
# it, admins get the password links in the app to pass on.
# SMTP_URL=smtp://user@mail.example.com:587
# SMTP_PASSWORD=
# SMTP_FROM=Socio <brain@example.com>

# Model: any OpenAI-compatible Chat Completions server. There is no default
# endpoint; leaving OPENAI_BASE_URL empty keeps the app in setup state. These
# settings seed the first inference backend once; after that operators manage
# backends in Settings → Platform and changes here no longer apply.
# A self-hosted model, for example (a server that ignores the key still
# needs a non-empty value):
# OPENAI_BASE_URL=http://model.example.test:8016/v1
# OPENAI_MODEL=local-model
# OPENAI_API_KEY=unused
# Per-response cap. On reasoning models it includes reasoning tokens, so keep
# it well above the expected answer length. Defaults to 2200 (agent turns) and
# 1800 (research briefs) when unset.
MODEL_MAX_COMPLETION_TOKENS=8192
# true only if the model takes image input; otherwise images (e.g. Telegram
# photos) reach it as a short text note.
MODEL_ACCEPTS_IMAGES=false
# With images on, the most recent images a request keeps (default 4, TensorFold's
# --vision-max-images); older ones become a note.
MODEL_MAX_IMAGES=4
# The model's context window in tokens (default 32768). Long chats are tidied
# to fit about 70% of it: big tool results cut, old ones set aside, the oldest
# turns kept as notes. Seeds the first backend; then Settings -> Platform.
# MODEL_CONTEXT_WINDOW=32768
# How long one turn may run (seconds, 10-3600; default 300). The shutdown drain
# follows it unless SHUTDOWN_DRAIN_MS is set.
# TURN_TIME_LIMIT_SECONDS=300
# Model rounds one Dot reply may use, tool rounds included (2-200; default 30).
# The last round has no tools: the Dot says what it did and what is left. An
# admin can change it in Settings -> General -> Dot replies.
# DOT_MAX_MODEL_ROUNDS=30
# About how much recalled context goes with each message (tokens, 250-8000;
# default 1000): the person's memories, and the pinned facts of a long chat that
# match it, in step. Only the turn's note changes, never the system prompt. An
# admin can change it in Settings -> General -> Socio replies.
# TURN_RECALL_TOKENS=1000
# How long an episode (what happened in a person's own chats, CB-180) is kept
# after it last came up, in days (1-3650; default 180). An admin can change it
# in Settings -> General -> Memory.
# EPISODE_RETENTION_DAYS=180
# How long a Space's shared memory keeps what is out of use (earlier versions,
# proposals turned down or taken back, retired entries; CB-181), in days
# (1-3650; default 365). Entries in use are kept. An admin can change it in
# Settings -> General -> Memory.
# SPACE_MEMORY_RETENTION_DAYS=365
# Messages one person may queue in a chat while the socio works (1-20; default
# 5). An admin can change it in Settings -> General -> Socio replies.
# STEERING_MAX_QUEUED=5
# Shared rooms: off unless true. Only the starting
# value: an admin turns it on or off in Settings -> General -> Rooms.
# ROOMS_ENABLED=false
# Whether room members see their room's use and limits (CB-218); room admins
# always do. Off unless true; an admin changes it in Settings -> General -> Rooms.
# ROOMS_BUDGET_VISIBLE=false
# What one message and the work it starts may use (CB-211); an admin can change
# each in Settings -> General -> Work per message. Model tokens, in and out
# (10000-20000000; default 2000000); messages a chat or Telegram topic takes a
# minute, from everyone in it (1-600; default 20); handoffs between socios
# (0-20; default 4); spend in USD where the model reports cost (0-1000; default
# 0, no spend cap). Its time is TURN_TIME_LIMIT_SECONDS.
# ROOM_CYCLE_TOKENS=2000000
# ROOM_MESSAGES_PER_MINUTE=20
# ROOM_HANDOFFS_PER_CYCLE=4
# ROOM_CYCLE_SPEND_USD=0
# The continuous copy's alerts (an admin can change them in Settings -> General
# -> Continuous copy alerts): admins are notified when Litestream's copy is this
# many minutes behind the newest write, or the database's write-ahead log this
# many MB.
# LITESTREAM_LAG_WARN_MINUTES=5
# LITESTREAM_LAG_CRITICAL_MINUTES=30
# LITESTREAM_WAL_WARN_MB=256
# LITESTREAM_WAL_CRITICAL_MB=1024
# Long chats' notes (an admin can change both in Settings -> General -> Long
# chats). Who writes them: shared (the default backend, with its one-shot
# options; the default) or chat (the chat's own model). Which pinned facts each
# prompt carries: relevance (those matching the request first, then the newest;
# the default), age (the newest) or pointer (a short core; the rest through
# search_notes).
# CONTEXT_SUMMARY_MODEL=shared
# CONTEXT_SELECTION=relevance
# The Operations dashboard's reporting time zone, where its days start (an
# admin can change it in Operations -> Settings). UTC when unset.
# OPS_TIME_ZONE=UTC
# How long a chat can go quiet before Operations counts a new session, in
# minutes, 1 to 1440 (an admin can change it in Operations -> Settings).
# OPS_SESSION_GAP_MINUTES=30
# Feature flags (CB-169): this server's default for some flags, as flag=on or
# flag=off, comma-separated. Admins override it in Settings -> Optional
# features and Early access; unknown flags are reported and ignored. Each
# flag's own default when unset.
# FEATURE_FLAGS=web-reads=on
# Deployment kind (CB-503): internal for a deployment the team that builds
# Socio uses to try features in development, which only it can have on (and
# its admins switch on Settings -> In development). Anything else, or unset,
# is a customer deployment: features in development stay off, whatever
# FEATURE_FLAGS says.
# SOCIO_DEPLOYMENT_KIND=internal
# The daily price sync behind Operations -> Cost (an admin can switch it in
# Operations -> Settings): on or off. Unset, it is on in production images
# (NODE_ENV=production) and off in development. It downloads public price
# lists (OpenRouter, DeepInfra, Azure Retail Prices, AWS Price List,
# models.dev, LiteLLM) with a generic user agent and no identifiers; off, no
# list is read. OPS_PRICE_SYNC_URL reads every list from this origin instead
# (an offline mirror or a loopback fake), path and query kept.
# OPS_PRICE_SYNC=on
# OPS_PRICE_SYNC_URL=
# Failure labels (CB-198): the workspace's model suggests a category for the
# failures Reliability's rules leave Unclassified. Off unless true; an admin
# can change all three in Operations -> Settings. The daily cap counts model
# calls; the threshold (0.5 to 0.99) is how sure the model must be, and how
# precise on the golden set of admin labels, before its labels count.
# CLASSIFY_FAILURES=false
# CLASSIFY_FAILURES_DAILY=200
# CLASSIFY_FAILURES_THRESHOLD=0.9
# Session intent and themes (CB-199): the workspace's model reads a chat's
# scrubbed title and first three person messages per session for Operations
# -> Themes. Off unless true; an admin can change them in Operations ->
# Settings, and edit intent's list of labels there.
# CLASSIFY_INTENT=false
# CLASSIFY_INTENT_DAILY=300
# CLASSIFY_INTENT_THRESHOLD=0.8
# CLASSIFY_THEMES=false
# CLASSIFY_THEMES_DAILY=300
# CLASSIFY_THEMES_THRESHOLD=0.7
# Learning triage (CB-200): the workspace's model reads each finished Learning
# conversation's scrubbed title and person messages (never replies), and only
# those showing a repeatable procedure go to the analysis; it also checks
# proposals for repeats and private details. Off unless true (Learning then
# works as before); an admin can change all three in Operations -> Settings.
# CLASSIFY_LEARNING=false
# CLASSIFY_LEARNING_DAILY=200
# CLASSIFY_LEARNING_THRESHOLD=0.9
# development or production (the default). Development lets operators stop all
# running work at once (Settings -> Platform, POST /api/operator/force-stop,
# scripts/wait-idle.mjs --force) so a deploy doesn't wait; production drains.
# APP_ENV=production
# true (APP_ENV=development only): SIGTERM stops running work at once instead
# of draining. Off by default.
# SHUTDOWN_FORCE=false
# Extra Chat Completions fields (JSON) for the short title generated after a
# conversation's first reply. For Qwen this skips thinking (~0.5 s, not ~3 s);
# leave empty for servers that reject unknown fields.
TITLE_MODEL_OPTIONS={"chat_template_kwargs":{"enable_thinking":false}}

# Vendor telemetry is always off: the server forces DO_NOT_TRACK and the
# CopilotKit opt-outs at startup (packages/foundation/src/no-vendor-telemetry.ts).

# Telegram (docs/SETUP.md#telegram). Empty token disables the channel. With
# Better Auth the bot also delivers one-time sign-in links ("Send me a
# sign-in link") to people who linked their Telegram.
TELEGRAM_BOT_TOKEN=
# Set to true in the one process that should long-poll the bot. Without it a
# token (e.g. exported by your shell for other tools) is ignored.
TELEGRAM_POLLING=
# Comma-separated group chat IDs (supergroups start with -100). DMs need only
# an account link. Messages from other groups are ignored.
TELEGRAM_ALLOWED_CHAT_IDS=
# The Dot that answers in Telegram; defaults to the first Dot.
# TELEGRAM_DOT_ID=

# Voice calls (CB-265): cloud (OpenAI Realtime, below) or self-hosted (the
# transcription server's realtime socket, the socio's own turns, and the
# speech server below). Admins can change it in Settings -> General -> Calls.
# VOICE_BACKEND=cloud
# Cloud calls: OpenAI Realtime.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin
# Self-hosted calls' speech: any OpenAI-compatible POST {URL}/v1/audio/speech
# that answers response_format=pcm (16-bit, 24 kHz). Unset: each device
# speaks the replies. The key (or VOICE_SPEECH_API_KEY_FILE) goes only to
# VOICE_SPEECH_URL's origin; a URL at the transcription server's origin gets
# the transcription key instead.
# VOICE_SPEECH_URL=
# VOICE_SPEECH_MODEL=kokoro
# VOICE_SPEECH_VOICE=auto
# VOICE_SPEECH_API_KEY=
# Composer dictation: both, device (browser speech recognition) or server
# (a recording sent to the transcription server below). Admins can change it
# in Settings.
# DICTATION_METHODS=both
# Server dictation's transcription server: any OpenAI-compatible
# speech-to-text server, POST {URL}/v1/audio/transcriptions. OpenAI's by
# default. A server in your own network keeps the audio there. Admins can
# change the URL and model in Settings -> General -> Transcription.
# VOICE_TRANSCRIBE_URL=https://api.openai.com
# VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional (or VOICE_TRANSCRIBE_API_KEY_FILE); sent only to
# VOICE_TRANSCRIBE_URL's origin, never to another URL set in Settings.
# Unset: VOICE_API_KEY for OpenAI's URL, and no Authorization header for
# any other server.
# VOICE_TRANSCRIBE_API_KEY=

# Optional persistent computers, one per Dot, using OpenBot (MIT) services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=company-brain
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# The computers' disk usage on Operations -> Health (CB-197), through the
# read-only Docker proxy in .docker/compose.computers.yml (computer-disk-usage). It
# takes COMPUTER_SUPERVISOR_TOKEN. Unset: disk usage shows as not set up.
# COMPUTER_DISK_USAGE_URL=http://127.0.0.1:4313
# ENGINE_SOCKET=/var/run/docker.sock

# Capability requests Dots may file (request_capability), per 24 hours.
# DOT_REQUESTS_PER_DOT_DAILY=5
# DOT_REQUESTS_PER_USER_DAILY=10

# Notifications from Dots (notify_user, docs/SETUP.md#notifications), per 24
# hours: from each Dot for a person, and for a person from all Dots.
# NOTIFY_PER_DOT_DAILY=20
# NOTIFY_PER_USER_DAILY=40
# The push services subscriptions may use (comma-separated; * for subdomains).
# Setting it replaces the default list, so keep the mobile app's push relay
# hosts in it (the last two), or phones lose their push. A bench relay on
# workers.dev needs its own host here.
# PUSH_ENDPOINT_HOSTS=*.googleapis.com,*.notify.windows.com,*.push.apple.com,*.push.services.mozilla.com,push.socio.sh,push-staging.socio.sh

# Public-web provider: parallel (default), searxng, browser (URL-only), or
# disabled. Queries and selected URLs are sent to Parallel; sample mode makes no
# provider calls. HTTP 429 (rate limit) is reported to the Dot, not a failed turn.
WEB_SEARCH_PROVIDER=parallel
# For searxng: your instance's base URL, with the json format enabled in its
# settings.yml (search.formats: [html, json]). Best effort: answers from search
# snippets and cannot read a specific page. Only queries are sent.
# SEARXNG_URL=http://127.0.0.1:8888
# Optional Bearer key for production/higher limits. Leave empty in dev: the
# anonymous MCP endpoint is free and rate-limited.
PARALLEL_API_KEY=

# Dot web reads (http_get/http_json; docs/SETUP.md "Web reads"). The default
# web identity for Dots without their own: agent (declared User-Agent
# SocioAgent/1.0 linking APP_ORIGIN/agents) or browser (the computer's
# browser). Requests never carry anything that identifies the user.
# WEB_IDENTITY_DEFAULT=agent
# Contact shown on the public /agents page (http(s) or mailto: URL; never sent
# in requests). Unset: "the operator of this workspace". Avoid a personal address.
# AGENTS_CONTACT=
# WEB_MAX_BYTES=2000000
# WEB_TIMEOUT_MS=15000
# WEB_HOST_RATE_PER_MINUTE=30
# WEB_GLOBAL_RATE_PER_MINUTE=300
# WEB_COOLDOWN_SECONDS=900
# WEB_CACHE_TTL_SECONDS=60

# Public client identity; operator branding settings override these defaults.
# BRAND_LOGO: same-origin asset path or PNG/JPEG/WebP base64 data URL (256 KB max).
BRAND_NAME=Socio
BRAND_LOGO=/favicon.svg
