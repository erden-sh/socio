{
    "name": "socio",
    "version": "0.53.1",
    "description": "Your team's workspace, with AI socios: chat, rooms, pages, a board and approvals in one place, on the web and on your phone.",
    "private": true,
    "homepage": "https://socio.sh",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/erden-sh/socio.git"
    },
    "scripts": {
        "dev": "cross-env NODE_ENV=development node --env-file-if-exists=.env --import tsx --watch-path=src/server --watch-path=packages/shared/src --watch-path=packages/foundation/src --watch-path=packages/data/src --watch-path=src/apps-runtime src/server/index.ts",
        "build": "node scripts/check-docs-boundary.mjs && react-router build && node scripts/check-ssr-deps.mjs && node scripts/precompress.mjs && node scripts/build-packages.mjs && tsc -p tsconfig.server.json && node scripts/build-planner-ui.mjs && node scripts/release-data.mjs && node scripts/released-migrations.mjs",
        "build:cached": "node scripts/turbo.mjs build",
        "build:pages": "node scripts/check-docs-boundary.mjs && react-router build && node scripts/check-ssr-deps.mjs && node scripts/precompress.mjs && node scripts/build-planner-ui.mjs",
        "build:packages": "node scripts/build-packages.mjs",
        "build:server": "tsc -p tsconfig.server.json",
        "build:release-data": "node scripts/release-data.mjs",
        "build:released-migrations": "node scripts/released-migrations.mjs",
        "planner:ui": "node scripts/build-planner-ui.mjs",
        "start": "node --env-file-if-exists=.env dist/server/server/index.js",
        "app-browser": "node --env-file-if-exists=.env --import tsx src/app-browser/main.ts",
        "coding-git": "node --env-file-if-exists=.env --import tsx src/coding-git/main.ts",
        "coding-git:start": "node --env-file-if-exists=.env dist/server/coding-git/main.js",
        "apps-runtime": "node --env-file-if-exists=.env --import tsx src/apps-runtime/index.ts",
        "apps-runtime:start": "node --env-file-if-exists=.env dist/server/apps-runtime/index.js",
        "test": "cross-env DO_NOT_TRACK=1 vitest run",
        "test:server": "cross-env DO_NOT_TRACK=1 vitest run --project server",
        "test:mixed": "cross-env DO_NOT_TRACK=1 vitest run --project mixed",
        "test:cached": "node scripts/turbo.mjs test",
        "test:changed": "cross-env DO_NOT_TRACK=1 vitest run --changed origin/main",
        "test:related": "cross-env DO_NOT_TRACK=1 vitest related --run",
        "typecheck": "node scripts/typecheck.mjs",
        "typecheck:root": "node scripts/typecheck.mjs root",
        "typecheck:mixed": "node scripts/typecheck.mjs mixed",
        "lint": "oxlint src packages apps/mobile apps/push-relay apps/link apps/site tests scripts vite.config.ts vitest.config.ts vitest.shared.ts react-router.config.ts",
        "lint:root": "oxlint src tests scripts vite.config.ts vitest.config.ts vitest.shared.ts react-router.config.ts",
        "format": "oxfmt --disable-nested-config",
        "check-format": "oxfmt --check --disable-nested-config",
        "check": "node scripts/check.mjs",
        "check:cached": "node scripts/turbo.mjs check",
        "release": "node --import tsx scripts/release.mjs",
        "release:check": "node --import tsx scripts/release.mjs --check",
        "smoke:ui": "node scripts/ui-smoke.mjs",
        "bench:loaders": "node --import tsx scripts/loader-bench.mjs",
        "bench:compression": "node --import tsx scripts/compression-bench.mjs",
        "bench:search": "node --import tsx scripts/search-bench.mjs",
        "exit-test": "node scripts/exit-test.mjs",
        "backup": "node --env-file-if-exists=.env dist/server/server/backup/backup-cli.js",
        "auth": "node --env-file-if-exists=.env dist/server/server/auth/auth-cli.js",
        "purge": "node --env-file-if-exists=.env dist/server/server/purge/purge-cli.js",
        "bundle": "node --env-file-if-exists=.env dist/server/server/bundle/bundle-cli.js",
        "key-id": "node dist/server/server/keys/key-id-cli.js",
        "postinstall": "node vendor/check-stubs.cjs",
        "check:docs-boundary": "node scripts/check-docs-boundary.mjs",
        "classify:eval": "node --env-file-if-exists=.env --import tsx scripts/classify-eval.ts",
        "ontology:graph": "node ontology/scripts/build-repo-graph.mjs",
        "ontology:check": "erden check ontology"
    },
    "keywords": [],
    "license": "SEE LICENSE IN LICENSE",
    "author": {
        "name": "Ingenio Ventures Inc."
    },
