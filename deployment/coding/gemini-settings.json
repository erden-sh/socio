{
    "general": {
        "enableAutoUpdate": false,
        "enableAutoUpdateNotification": false,
        "enableNotifications": false,
        "checkpointing": {
            "enabled": false
        }
    },
    "privacy": {
        "usageStatisticsEnabled": false
    },
    "telemetry": {
        "enabled": false,
        "logPrompts": false,
        "traces": false
    },
    "security": {
        "folderTrust": {
            "enabled": false
        }
    },
    "advanced": {
        "ignoreLocalEnv": true
    },
    "admin": {
        "mcp": {
            "enabled": false
        },
        "extensions": {
            "enabled": false
        }
    },
    "tools": {
        "exclude": ["google_web_search", "web_fetch"],
        "disableLLMCorrection": true,
        "shell": {
            "enableInteractiveShell": false
        }
    },
    "model": {
        "name": "$SOCIO_GEMINI_MODEL",
        "disableLoopDetection": true,
        "skipNextSpeakerCheck": true
    },
    "modelConfigs": {
        "customAliases": {
            "classifier": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "prompt-completion": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "fast-ack-helper": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "edit-corrector": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "summarizer-default": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "summarizer-shell": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "web-fetch-fallback": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "loop-detection": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "loop-detection-double-check": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "llm-edit-fixer": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "next-speaker-checker": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
                }
            },
            "context-snapshotter": {
                "modelConfig": {
                    "model": "$SOCIO_GEMINI_MODEL"
