{
    "$schema": "./node_modules/turbo/schema.json",
    "cacheMaxAge": "14d",
    "cacheMaxSize": "20GB",
    "envMode": "strict",
    "globalDependencies": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        ".npmrc",
        ".node-version",
        ".nvmrc",
        "turbo.json",
        "packages/*/turbo.json",
        "packages/*/package.json",
        "apps/mobile/turbo.json",
        "apps/mobile/package.json",
        "apps/push-relay/turbo.json",
        "apps/push-relay/package.json",
        "apps/link/turbo.json",
        "apps/link/package.json",
        "apps/site/turbo.json",
        "apps/site/package.json",
        "tsconfig*.json",
        "packages/*/tsconfig.json",
        "tests/integration/tsconfig.json",
        ".gitignore",
        "vitest.config.ts",
        "vitest.shared.ts",
        "packages/client/vitest.config.ts",
        "vite.config.ts",
        "react-router.config.ts",
        ".oxlintrc.json",
        ".oxfmtrc.json",
        ".gitattributes",
        "tests/setup/**",
        "scripts/turbo.mjs",
        "scripts/typecheck.mjs",
        "scripts/lint/**",
        ".github/ci/**"
    ],
    "globalEnv": [
        "CI",
        "DO_NOT_TRACK",
        "NODE_ENV",
        "TZ",
        "LANG",
        "LC_ALL",
        "SOCIO_TOOLCHAIN",
        "PLAYWRIGHT_BROWSERS_PATH",
        "VITE_*",
        "COMPUTER_ISOLATION_TEST_IMAGE",
        "SUPERVISOR_ISOLATION_TEST_IMAGE",
        "OPS_PERF",
        "OPS_PERF_TURNS",
        "OPS_PERF_REPORT",
        "REPLAY_BENCH"
    ],
    "globalPassThroughEnv": ["TMPDIR", "XDG_CACHE_HOME", "npm_config_update_notifier"],
    "noUpdateNotifier": true,
    "remoteCache": {
        "enabled": false
    },
    "tasks": {
        "//#build:packages": {
            "description": "scripts/build-packages.mjs: @socio/shared, @socio/i18n, @socio/foundation and @socio/data to their dist, and shipped with the server build.",
            "inputs": [
                "packages/shared/**",
                "packages/i18n/**",
                "packages/foundation/**",
                "packages/data/**",
                "scripts/build-packages.mjs",
                "scripts/workspace-packages.mjs",
                "!packages/*/tests/**",
                "!packages/*/dist/**",
                "!packages/*/node_modules/**",
                "!packages/*/.turbo/**",
                "!**/*.md"
            ],
            "outputs": [
                "packages/shared/dist/**",
                "packages/i18n/dist/**",
                "packages/foundation/dist/**",
                "packages/data/dist/**",
                "dist/server/node_modules/@socio/**"
            ]
        },
        "//#build:release-data": {
            "cache": false,
            "dependsOn": ["//#build:server"],
            "description": "Never cached: dist/server/releases.json holds the commit it was built from.",
            "env": ["APP_COMMIT"]
        },
        "//#build:released-migrations": {
            "dependsOn": ["//#build:server", "//#build:packages"],
            "description": "scripts/released-migrations.mjs: the server build's checksum of every migration of the release in package.json is the one it shipped with.",
            "inputs": ["src/server/modules/released-migrations.json", "scripts/released-migrations.mjs"],
            "outputs": []
        },
        "//#build:server": {
            "dependsOn": ["//#build:packages"],
            "description": "tsc -p tsconfig.server.json, which reads the workspace packages' declarations.",
            "inputs": [
                "$TURBO_DEFAULT$",
                "!packages/client/**",
                "!packages/plugin-ui/**",
                "!tests/**",
                "!docs/**",
                "!content/**",
                "!marketing/**",
                "!apps/mobile/**",
                "!apps/push-relay/**",
                "!apps/link/**",
                "!apps/site/**",
                "!**/*.md",
                "!**/node_modules/**",
                "!.turbo/**",
                "!**/.turbo/**",
                "!.turbo-ci/**",
                "!.git/**",
                "!.env",
                "!data/**",
                "!.socio/**",
                "!artifacts/**",
                "!playwright-report/**",
                "!test-results/**",
                "!.react-router/**",
                "!.copilotkit/**",
                "!**/*.sqlite",
                "!**/*.sqlite-shm",
                "!**/*.sqlite-wal",
                "!.DS_Store",
                "!RESEARCH.md",
                "!docs/superpowers/**",
                "!packages/*/dist/**",
                "!dist/**",
                "!src/server/plugins/planner/ui/**"
            ],
            "outputs": ["dist/server/**", "!dist/server/node_modules/**", "!dist/server/releases.json"]
        },
        "//#check-format": {
            "description": "oxfmt --check over the whole repository: every tracked file is its input.",
            "inputs": ["$TURBO_DEFAULT$"],
            "outputs": []
        },
        "//#lint:root": {
            "description": "oxlint over what the root's lint names outside packages/. Its import rules read what those files import, tests/integration's reach into the client among it.",
            "inputs": [
                "$TURBO_DEFAULT$",
                "!docs/**",
                "!content/**",
                "!marketing/**",
                "!apps/mobile/**",
                "!apps/push-relay/**",
                "!apps/link/**",
                "!apps/site/**",
                "!**/*.md",
                "!**/node_modules/**",
                "!.turbo/**",
                "!**/.turbo/**",
                "!.turbo-ci/**",
                "!.git/**",
                "!.env",
                "!data/**",
                "!.socio/**",
                "!artifacts/**",
                "!playwright-report/**",
                "!test-results/**",
                "!.react-router/**",
                "!.copilotkit/**",
                "!**/*.sqlite",
                "!**/*.sqlite-shm",
                "!**/*.sqlite-wal",
                "!.DS_Store",
                "!RESEARCH.md",
                "!docs/superpowers/**",
                "!packages/*/dist/**",
                "!dist/**",
                "!src/server/plugins/planner/ui/**"
            ],
            "outputs": []
        },
        "//#test:mixed": {
            "description": "tests/integration: both sides are inputs, and what a build leaves that its tests read when it exists: the pages (docs-built.test.ts) and the planner's client (plugins.test.ts).",
            "inputs": [
                "$TURBO_DEFAULT$",
                "dist/web/**",
                "src/server/plugins/planner/ui/**",
                "!marketing/**",
                "!apps/mobile/**",
                "!apps/push-relay/**",
                "!apps/link/**",
                "!apps/site/**",
                "!.agents/**",
                "!.claude/**",
                "!README.md",
                "!AGENTS.md",
                "!CLAUDE.md",
                "!CONTRIBUTING.md",
                "!SECURITY.md",
                "!docs/CODING.md",
                "!docs/COMPUTERS.md",
                "!docs/CONNECTED-AGENTS.md",
                "!docs/DATA-LAYER.md",
                "!docs/IN-APP-HELP.md",
                "!docs/MEMORY.md",
                "!docs/ONBOARDING.md",
                "!docs/OPERATIONS-ANALYTICS.md",
                "!docs/PLUGINS.md",
                "!docs/RELEASING.md",
                "!docs/SERVICE-ACCOUNTS.md",
                "!docs/SETUP.md",
                "!docs/TOOLING.md",
                "!docs/images/**",
                "!**/node_modules/**",
                "!.turbo/**",
                "!**/.turbo/**",
                "!.turbo-ci/**",
                "!.git/**",
                "!.env",
                "!data/**",
                "!.socio/**",
                "!artifacts/**",
                "!playwright-report/**",
                "!test-results/**",
                "!.react-router/**",
                "!.copilotkit/**",
                "!**/*.sqlite",
                "!**/*.sqlite-shm",
                "!**/*.sqlite-wal",
                "!.DS_Store",
                "!RESEARCH.md",
                "!docs/superpowers/**",
                "!packages/*/dist/**",
                "!dist/server/**"
            ],
            "outputs": []
        },
        "//#test:server": {
            "description": "tests/, except tests/integration. Nothing on the client side is an input: tests/setup/no-client-* and scripts/check-test-buckets.mjs keep that true.",
            "inputs": [
                "$TURBO_DEFAULT$",
                "!packages/client/**",
                "!packages/plugin-ui/**",
                "!tests/integration/**",
                "!marketing/**",
                "!apps/mobile/**",
                "!apps/push-relay/**",
                "!apps/link/**",
                "!apps/site/**",
                "!.agents/**",
                "!.claude/**",
                "!README.md",
                "!AGENTS.md",
                "!CLAUDE.md",
                "!CONTRIBUTING.md",
                "!SECURITY.md",
                "!docs/CODING.md",
                "!docs/COMPUTERS.md",
                "!docs/CONNECTED-AGENTS.md",
                "!docs/DATA-LAYER.md",
                "!docs/IN-APP-HELP.md",
                "!docs/MEMORY.md",
                "!docs/ONBOARDING.md",
                "!docs/OPERATIONS-ANALYTICS.md",
                "!docs/PLUGINS.md",
                "!docs/RELEASING.md",
                "!docs/SERVICE-ACCOUNTS.md",
                "!docs/SETUP.md",
                "!docs/TOOLING.md",
                "!docs/images/**",
                "!**/node_modules/**",
                "!.turbo/**",
                "!**/.turbo/**",
                "!.turbo-ci/**",
                "!.git/**",
                "!.env",
                "!data/**",
                "!.socio/**",
                "!artifacts/**",
                "!playwright-report/**",
                "!test-results/**",
                "!.react-router/**",
                "!.copilotkit/**",
                "!**/*.sqlite",
                "!**/*.sqlite-shm",
                "!**/*.sqlite-wal",
                "!.DS_Store",
                "!RESEARCH.md",
                "!docs/superpowers/**",
                "!packages/*/dist/**",
                "!dist/**",
                "!src/server/plugins/planner/ui/**"
            ],
            "outputs": []
        },
        "//#typecheck:mixed": {
            "description": "tests/integration, which reaches both sides.",
            "inputs": [
                "$TURBO_DEFAULT$",
                "!docs/**",
                "!content/**",
                "!marketing/**",
                "!apps/mobile/**",
                "!apps/push-relay/**",
                "!apps/link/**",
                "!apps/site/**",
                "!**/*.md",
                "!**/node_modules/**",
                "!.turbo/**",
                "!**/.turbo/**",
                "!.turbo-ci/**",
                "!.git/**",
                "!.env",
                "!data/**",
                "!.socio/**",
                "!artifacts/**",
                "!playwright-report/**",
                "!test-results/**",
                "!.react-router/**",
                "!.copilotkit/**",
                "!**/*.sqlite",
                "!**/*.sqlite-shm",
                "!**/*.sqlite-wal",
                "!.DS_Store",
                "!RESEARCH.md",
                "!docs/superpowers/**",
                "!packages/*/dist/**",
                "!dist/**",
                "!src/server/plugins/planner/ui/**"
            ],
            "outputs": []
        },
        "//#typecheck:root": {
            "description": "The server, services and server tests. Reaches no client file (tests/integration/turbo.test.ts).",
            "inputs": [
                "$TURBO_DEFAULT$",
                "!packages/client/**",
                "!packages/plugin-ui/**",
                "!tests/integration/**",
                "!docs/**",
                "!content/**",
                "!marketing/**",
                "!apps/mobile/**",
                "!apps/push-relay/**",
                "!apps/link/**",
                "!apps/site/**",
                "!**/*.md",
                "!**/node_modules/**",
                "!.turbo/**",
                "!**/.turbo/**",
                "!.turbo-ci/**",
                "!.git/**",
                "!.env",
                "!data/**",
                "!.socio/**",
                "!artifacts/**",
                "!playwright-report/**",
                "!test-results/**",
                "!.react-router/**",
                "!.copilotkit/**",
                "!**/*.sqlite",
                "!**/*.sqlite-shm",
                "!**/*.sqlite-wal",
                "!.DS_Store",
                "!RESEARCH.md",
                "!docs/superpowers/**",
                "!packages/*/dist/**",
                "!dist/**",
                "!src/server/plugins/planner/ui/**"
            ],
            "outputs": []
        }
    },
    "ui": "stream"
}
