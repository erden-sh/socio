{
    "name": "@socio/foundation",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The server's lowest layer with no database: secrets and keys, token redaction, HTTP middleware, failure text. Separate services import it, so what they reach needs no third-party module.",
    "scripts": {
        "typecheck": "pnpm -w exec tsc -p packages/foundation/tsconfig.json --noEmit",
        "lint": "pnpm -w exec oxlint packages/foundation"
    },
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "dependencies": {
        "@ag-ui/core": "^0.0.59",
        "@socio/shared": "workspace:*",
        "hono": "^4.13.11"
    },
    "devDependencies": {
        "@ag-ui/client": "^0.0.59",
        "@copilotkit/runtime": "^1.75.0",
        "@tanstack/ai": "^0.63.0",
        "@types/node": "^26.6.3",
        "vitest": "^4.1.11",
        "zod": "^4.6.5"
    },
    "license": "SEE LICENSE IN ../../LICENSE"
}
