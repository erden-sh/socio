{
    "name": "@socio/ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Socio's React components, interaction patterns and visual themes.",
    "license": "SEE LICENSE IN dist/LICENSE",
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-notices.mjs",
        "prepack": "pnpm run build",
        "typecheck": "tsc --noEmit",
        "lint": "pnpm -w exec oxlint packages/ui"
    },
    "exports": {
        ".": "./src/index.ts",
        "./components/return-focus": "./src/components/return-focus.ts",
        "./components/use-mobile": "./src/components/use-mobile.ts",
        "./components/*": "./src/components/*.tsx",
        "./utils": "./src/utils.ts",
        "./theme.css": "./src/styles/theme.css",
        "./tokens.css": "./src/styles/tokens.css",
        "./themes/*.css": "./src/styles/themes/*.css",
        "./styles.css": "./dist/styles.css"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "./components/*": {
                "types": "./dist/components/*.d.ts",
                "import": "./dist/components/*.js"
            },
            "./utils": {
                "types": "./dist/utils.d.ts",
                "import": "./dist/utils.js"
            },
            "./styles.css": "./dist/styles.css"
        }
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.80.0",
        "radix-ui": "^1.8.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.1"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/react": "^19.3.2",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "7.1.0-beta",
        "vite": "^8.3.8"
    }
}
