{
    "name": "@socio/plugin-ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Shared UI for Socio plugin apps: calendar, editor shell, preview frame, catalog cards, page shell, and the iframe bridge.",
    "scripts": {
        "typecheck": "pnpm -w exec tsc -p packages/plugin-ui/tsconfig.json --noEmit",
