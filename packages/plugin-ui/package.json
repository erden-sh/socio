        "./plugin.css": "./src/plugin.css",
        "./preview.css": "./src/preview.css"
    },
    "dependencies": {
        "@socio/shared": "workspace:*"
    },
    "peerDependencies": {
        "lucide-react": "^1.48.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
