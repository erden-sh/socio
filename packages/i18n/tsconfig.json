{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        "types": ["node"],
        "paths": {
            "@socio/shared/*": ["../shared/src/*.ts"]
        }
    },
    "include": ["src", "tests"]
}
