sid:package-effect-acp
    a socio:Package, socio:VendoredPackage ;
    rdfs:label "effect-acp" ;
    socio:packageName "effect-acp" ;
    socio:sourcePath "vendor/t3code/effect-acp" .

sid:package-effect-codex-app-server
    a socio:Package, socio:VendoredPackage ;
    rdfs:label "effect-codex-app-server" ;
    socio:packageName "effect-codex-app-server" ;
    socio:sourcePath "vendor/t3code/effect-codex-app-server" .

sid:package-socio
    a socio:Package ;
    dcterms:description "Your team's workspace, with AI socios: chat, rooms, pages, a board and approvals in one place, on the web and on your phone." ;
    rdfs:label "socio" ;
    socio:dependsOn sid:package-effect-acp, sid:package-effect-codex-app-server, sid:package-socio-data, sid:package-socio-foundation, sid:package-socio-plugin-ui, sid:package-socio-shared, sid:package-t3tools-contracts, sid:package-t3tools-provider-acp, sid:package-t3tools-provider-acp-registry, sid:package-t3tools-provider-codex, sid:package-t3tools-provider-core, sid:package-t3tools-provider-grok, sid:package-t3tools-provider-opencode, sid:package-t3tools-provider-pi, sid:package-t3tools-secret-provider-core, sid:package-t3tools-shared ;
    socio:packageName "socio" ;
    socio:sourcePath "." .

sid:package-socio-app-sdk
    a socio:Package ;
    dcterms:description "Socio mini app SDK (CB-232): verifies the x-cb-actor envelope, authorizes actions by tier, consumes action approvals and calls the data API on behalf of the request's person or socio." ;
    rdfs:label "@socio/app-sdk" ;
    socio:packageName "@socio/app-sdk" ;
    socio:sourcePath "packages/app-sdk" .

sid:package-socio-client
    a socio:Package ;
    dcterms:description "Socio's React client: the pages React Router renders on the server and hydrates in the browser. Built from the repository root to dist/web." ;
    rdfs:label "@socio/client" ;
    socio:dependsOn sid:package-socio-plugin-ui, sid:package-socio-shared ;
    socio:packageName "@socio/client" ;
    socio:sourcePath "packages/client" .

sid:package-socio-data
    a socio:Package ;
    dcterms:description "Socio's SQLite layer: opening and pragmas, the unit of work, column helpers, the migration runner and the backup it takes first." ;
    rdfs:label "@socio/data" ;
    socio:packageName "@socio/data" ;
    socio:sourcePath "packages/data" .

sid:package-socio-foundation
    a socio:Package ;
    dcterms:description "The server's lowest layer with no database: secrets and keys, token redaction, HTTP middleware, failure text. Separate services import it, so what they reach needs no third-party module." ;
    rdfs:label "@socio/foundation" ;
    socio:dependsOn sid:package-socio-shared ;
    socio:packageName "@socio/foundation" ;
    socio:sourcePath "packages/foundation" .

sid:package-socio-link
    a socio:App, socio:Package ;
    dcterms:description "Socio's link domain (link.socio.sh): a serverless worker that serves the app's verified-link files (AASA, assetlinks.json) and the static pages behind each app link." ;
    rdfs:label "@socio/link" ;
    socio:dependsOn sid:package-socio-shared ;
    socio:packageName "@socio/link" ;
    socio:sourcePath "apps/link" .

sid:package-socio-mobile
    a socio:App, socio:Package ;
    dcterms:description "Socio's native app for phones (Expo, React Native). A skeleton for now." ;
    rdfs:label "@socio/mobile" ;
    socio:dependsOn sid:package-socio-shared ;
    socio:packageName "@socio/mobile" ;
    socio:sourcePath "apps/mobile" .

sid:package-socio-plugin-ui
    a socio:Package ;
    dcterms:description "Shared UI for Socio plugin apps: calendar, editor shell, preview frame, catalog cards, page shell, and the iframe bridge." ;
    rdfs:label "@socio/plugin-ui" ;
    socio:dependsOn sid:package-socio-shared ;
    socio:packageName "@socio/plugin-ui" ;
    socio:sourcePath "packages/plugin-ui" .

sid:package-socio-push-relay
    a socio:App, socio:Package ;
    dcterms:description "Socio's push relay: a serverless worker that forwards end-to-end encrypted Web Push to the phone platforms’ push services. Registrations, the Web Push receiver, quotas, and the clients of the phone platforms’ push services." ;
    rdfs:label "@socio/push-relay" ;
    socio:packageName "@socio/push-relay" ;
    socio:sourcePath "apps/push-relay" .

sid:package-socio-shared
    a socio:Package ;
    dcterms:description "Code and types shared by Socio's server, client and services: no imports from the app, importable by subpath (@socio/shared/rooms/rooms)." ;
    rdfs:label "@socio/shared" ;
    socio:packageName "@socio/shared" ;
    socio:sourcePath "packages/shared" .

sid:package-socio-site
    a socio:App, socio:Package ;
    dcterms:description "Socio's public site (socio.sh): static pages built with Vite and Tailwind, served by a serverless worker with static assets. The store-facing privacy, terms, cookies, delete-account and support pages live here." ;
    rdfs:label "@socio/site" ;
    socio:packageName "@socio/site" ;
    socio:sourcePath "apps/site" .

