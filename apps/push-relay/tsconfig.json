{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        // The Workers runtime's globals (fetch, crypto.subtle, ExportedHandler), not Node's or the DOM's.
        "types": ["@cloudflare/workers-types"]
    },
    "include": ["src", "tests"]
}
