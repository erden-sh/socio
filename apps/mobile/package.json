{
    "name": "@socio/mobile",
    "version": "0.2.7",
    "private": true,
    "description": "Socio's native app for iOS and Android (Expo, React Native). A skeleton for now.",
    "main": "index.ts",
    "scripts": {
        "start": "cross-env EXPO_NO_TELEMETRY=1 EXPO_OFFLINE=1 DO_NOT_TRACK=1 EXPO_UNSTABLE_BONJOUR=0 expo start --dev-client",
        "android": "cross-env EXPO_NO_TELEMETRY=1 EXPO_OFFLINE=1 DO_NOT_TRACK=1 EXPO_UNSTABLE_BONJOUR=0 expo run:android",
        "ios": "cross-env EXPO_NO_TELEMETRY=1 EXPO_OFFLINE=1 DO_NOT_TRACK=1 EXPO_UNSTABLE_BONJOUR=0 expo run:ios",
        "typecheck": "pnpm -w exec tsc -p apps/mobile/tsconfig.json --noEmit",
        "lint": "pnpm -w exec oxlint apps/mobile",
        "test": "cross-env DO_NOT_TRACK=1 vitest run",
        "build": "cross-env EXPO_NO_TELEMETRY=1 EXPO_OFFLINE=1 DO_NOT_TRACK=1 expo export --platform android --platform ios --output-dir dist"
    },
    "dependencies": {
        "@10play/tentap-editor": "1.1.0",
        "@legendapp/list": "3.3.5",
        "@react-native-community/datetimepicker": "9.2.1",
        "@react-native-community/netinfo": "12.0.1",
        "@react-native-menu/menu": "2.3.4",
        "@react-native-segmented-control/segmented-control": "2.5.7",
        "@react-navigation/bottom-tabs": "7.22.0",
        "@react-navigation/native": "7.5.2",
        "@react-navigation/native-stack": "7.21.1",
        "@socio/shared": "workspace:*",
        "@tanstack/db": "1.0.0-rc.1.5",
        "@tanstack/react-db": "1.0.0-rc.1.5",
        "eventsource-parser": "4.1.3",
        "expo": "58.0.26",
        "expo-build-properties": "58.0.12",
        "expo-clipboard": "58.0.4",
        "expo-constants": "58.0.16",
        "expo-crypto": "58.0.8",
        "expo-dev-client": "58.0.21",
        "expo-document-picker": "58.0.5",
        "expo-file-system": "58.0.14",
        "expo-glass-effect": "58.0.5",
        "expo-haptics": "58.0.8",
        "expo-image": "58.0.18",
        "expo-image-manipulator": "58.0.16",
        "expo-image-picker": "58.0.10",
        "expo-notifications": "58.1.9",
        "expo-paste-input": "0.2.2",
        "expo-secure-store": "58.0.3",
        "expo-sharing": "58.0.23",
        "expo-splash-screen": "58.0.14",
        "expo-sqlite": "58.0.18",
        "expo-status-bar": "58.0.5",
        "expo-symbols": "58.0.5",
        "expo-system-ui": "58.0.7",
        "expo-web-browser": "58.1.0",
        "lucide-react-native": "1.80.0",
        "react": "19.3.0",
        "react-native": "0.88.1",
        "react-native-enriched-markdown": "file:deps/react-native-enriched-markdown-1.2.0-t3.16-29ddd424-grammars.tgz",
        "react-native-gesture-handler": "3.3.0",
        "react-native-get-random-values": "2.1.0",
        "react-native-keyboard-controller": "1.22.8",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "5.11.1",
        "react-native-screens": "4.30.1",
        "react-native-svg": "15.16.0",
        "react-native-webview": "14.0.1",
        "react-native-worklets": "0.13.0",
        "uniwind": "1.14.0"
    },
    "devDependencies": {
        "@ag-ui/core": "1.0.5",
        "@babel/core": "7.29.7",
        "@bacons/apple-targets": "5.0.0",
        "@types/react": "19.3.2",
        "babel-plugin-react-compiler": "1.0.0",
        "babel-preset-expo": "58.0.26",
        "cross-env": "10.1.0",
        "metro": "0.87.1",
        "metro-cache": "0.87.1",
        "metro-transform-worker": "0.87.1",
        "react-refresh": "0.14.2",
        "tailwindcss": "4.3.5",
        "vitest": "5.1.2"
    },
    "enriched-markdown": {
        "enableCodeHighlight": true,
        "enableMath": false,
        "enableVideo": false
    },
    "expo": {
        "install": {
            "exclude": [
                "@legendapp/list",
                "react-native-enriched-markdown",
                "react-native-keyboard-controller"
            ]
        },
        "autolinking": {
            "exclude": [
                "@bacons/apple-targets"
            ],
            "buildFromSource": [
                "expo-sqlite",
                "react-native-keyboard-controller"
            ]
        }
    },
    "engines": {
        "node": ">=26.13.0 <27",
        "pnpm": ">=10.15 <11"
    },
    "license": "SEE LICENSE IN ../../LICENSE"
}
